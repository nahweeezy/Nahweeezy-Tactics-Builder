# Copy this file to `.env` for local dev, and set the same vars on Vercel.

# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Google Analytics 4
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Local dev: skip the login gate. Leave unset in production.
# Per-page override (dev builds only): append ?bypass=1 to the URL.
# VITE_BYPASS_AUTH=1
